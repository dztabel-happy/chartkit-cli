{
  "version": "0.1",
  "type": "ranked_contribution",
  "figure_mode": "data_figure",
  "profile": "report_a4.full_width",
  "caption": "日度收益排序贡献图，同时展示亏损尾部、盈利集中度与累计贡献占比。",
  "contract": {
    "conclusion": "少量高盈利日贡献了大部分累计净收益，同时 48 个亏损日形成清晰亏损尾部。",
    "role": "ranking",
    "archetype": "quantitative_grid",
    "evidence_hierarchy": {
      "hero": "正负收益排序贡献与累计占比"
    },
    "statistics": [
      {
        "panel": "main",
        "n_definition": "246 个日度观测",
        "center": "日净收益",
        "interval": "未显示",
        "ordering": "按日净收益排序"
      }
    ],
    "source_data": [
      {
        "panel": "main",
        "path": "source/13-ranked-contribution-pareto.csv"
      }
    ],
    "visual_constraints": {
      "data_first": true,
      "no_metric_cards": true,
      "no_explanatory_paragraphs": true
    }
  },
  "data": {
    "source": "source/13-ranked-contribution-pareto.csv",
    "label_col": "date",
    "value_col": "daily_net_profit_wan",
    "sort": "ascending",
    "cumulative": {
      "mode": "positive_share"
    },
    "quantiles": [
      0.25,
      0.5,
      0.75
    ],
    "shade_negative": true,
    "negative_region_label": "亏损尾部 48 天",
    "annotate_extremes": true,
    "x_tick_mode": "rank",
    "max_x_ticks": 6,
    "legend_labels": {
      "negative": "亏损日",
      "positive": "盈利日",
      "cumulative": "累计净收益贡献"
    }
  },
  "xAxis": {
    "label": "交易日排序（由低到高）"
  },
  "yAxis": {
    "label": "日净收益（万元）"
  },
  "y2Axis": {
    "label": "累计净收益贡献（%）",
    "range": [
      0,
      105
    ]
  },
  "legend": {
    "position": "upper center",
    "bbox_to_anchor": [
      0.5,
      1.14
    ],
    "ncol": 3
  }
}
